# Copy this file to .env and fill in values. Never commit .env.

# PostgreSQL connection string.
# Use managed Postgres on Render or Railway for the deployed environment.
#   Local example:    postgres://localhost:5432/tapa_trust
#   Render example:    postgres://USER:PASSWORD@HOST.oregon-postgres.render.com/DBNAME
#   Railway example:   postgres://USER:PASSWORD@HOST.proxy.rlwy.net:PORT/railway
DATABASE_URL=postgres://localhost:5432/tapa_trust

# SSL for the database connection.
# Leave unset to auto-detect: off for localhost, on for managed hosts.
# Managed Postgres (Render/Railway) needs SSL, so set DATABASE_SSL=true if
# auto-detection ever guesses wrong. Force off locally with DATABASE_SSL=false.
# DATABASE_SSL=

# Secret used to sign JWTs. Use a long random string in real environments.
JWT_SECRET=change-me-to-a-long-random-string

# Port the Express API listens on. Render sets PORT automatically in production.
PORT=4000

# Allowed browser origin for CORS (the deployed client URL).
# Local default if unset: all origins are allowed.
#   Example: https://your-client.vercel.app
CLIENT_ORIGIN=
