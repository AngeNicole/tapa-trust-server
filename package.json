{
  "name": "tapa-trust-server",
  "version": "0.1.0",
  "private": true,
  "description": "TaPa Trust REST API (Node + Express + PostgreSQL).",
  "type": "commonjs",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "migrate": "node db/migrate.js",
    "seed": "node db/seed.js",
    "seed:admin": "node db/seed-admin.js",
    "alter": "node db/alter.js",
    "alter:profile": "node db/alter.js alter-add-profile-fields.sql",
    "alter:chat": "node db/alter.js alter-add-booking-chat.sql",
    "alter:category-status": "node db/alter.js alter-add-category-status.sql",
    "alter:cancel-reason": "node db/alter.js alter-add-cancel-reason.sql",
    "alter:agreements": "node db/alter.js alter-add-agreements-escrow.sql",
    "alter:verification": "node db/alter.js alter-add-verification-evidence.sql",
    "test": "DATABASE_URL=postgres://localhost:5432/tapa_trust_test JWT_SECRET=test-secret jest --runInBand --forceExit"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.7",
    "supertest": "^7.2.2"
  }
}
